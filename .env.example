# Copy to .env and fill in. NEVER commit real secrets.
TALVYNZA_ENVIRONMENT=development
# development | test | production
TALVYNZA_SECRET_KEY=
# required in production: 32+ random chars (e.g. openssl rand -base64 48)
TALVYNZA_FIELD_ENCRYPTION_KEY=
# optional Fernet key: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
TALVYNZA_DATABASE_URL=postgresql+psycopg://talvynza:change-me-locally@localhost:5432/talvynza
TALVYNZA_REDIS_URL=redis://localhost:6379/0
TALVYNZA_CORS_ORIGINS=http://localhost:5173
TALVYNZA_FRONTEND_URL=http://localhost:5173
TALVYNZA_EMAIL_BACKEND=console
# console | smtp   (memory is test-only and refused in production)
TALVYNZA_EMAIL_FROM=no-reply@example.com
TALVYNZA_SMTP_HOST=
TALVYNZA_SMTP_PORT=587
TALVYNZA_SMTP_USER=
TALVYNZA_SMTP_PASSWORD=
TALVYNZA_REQUIRE_EMAIL_VERIFICATION=true
TALVYNZA_COOKIE_SECURE=
# blank => true when TALVYNZA_ENVIRONMENT=production

# Optional local Tali AI. Run Ollama and pull qwen3:0.6b before enabling.
TALVYNZA_AI_ENABLED=false
TALVYNZA_AI_PROVIDER=ollama
TALVYNZA_AI_OLLAMA_URL=http://127.0.0.1:11434
TALVYNZA_AI_MODEL=qwen3:0.6b
# For Railway, set provider=groq and provide this secret in Railway variables.
TALVYNZA_AI_GROQ_API_KEY=
TALVYNZA_AI_GROQ_MODEL=openai/gpt-oss-20b

# docker-compose only
POSTGRES_USER=talvynza
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=talvynza
