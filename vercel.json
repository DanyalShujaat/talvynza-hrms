{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm --prefix apps/web ci",
  "buildCommand": "npm --prefix apps/web run build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://nexora-hrms-production.up.railway.app/api/:path*" },
    { "source": "/health", "destination": "https://nexora-hrms-production.up.railway.app/health" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
